# --- обязательные ---------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/lead_router?schema=public"
ADMIN_PASSWORD="change-me"

# --- бот (обязательно для процессов bot / ticker) --------------------------
BOT_TOKEN=""

# --- необязательные --------------------------------------------------------
# Чат, куда падают уведомления о потерянных заявках. Можно задать и в /settings.
ESCALATION_CHAT_ID=""

# Google Sheets. Если пусто — outbox складывает задания, но не отправляет их.
GOOGLE_SHEETS_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Приватный ключ одной строкой, переводы строк экранированы как \n
GOOGLE_PRIVATE_KEY=""

# --- тайминги воркеров -----------------------------------------------------
TICKER_INTERVAL_MS="10000"
OUTBOX_INTERVAL_MS="5000"

NODE_ENV="development"

# База для интеграционных тестов (создаётся автоматически)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5433/lead_router_test?schema=public"
